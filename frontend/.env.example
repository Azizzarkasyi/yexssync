# ==============================================================================
# HADIRYUK FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Salin file ini menjadi .env lalu sesuaikan nilainya sesuai lingkungan Anda.
# ==============================================================================

# [1] API Endpoint Backend
EXPO_PUBLIC_API_URL=https://api-presensi.domainanda.com/api

# [2] Metadata Aplikasi & Tenant
EXPO_PUBLIC_APP_NAME=YexsSync
EXPO_PUBLIC_APP_VERSION=2.1.0
EXPO_PUBLIC_DEFAULT_TENANT_ID=1

# [3] Konfigurasi Leaflet Peta & Geofencing (OpenStreetMap)
EXPO_PUBLIC_MAP_DEFAULT_LAT=-6.2088
EXPO_PUBLIC_MAP_DEFAULT_LNG=106.8456
EXPO_PUBLIC_MAP_DEFAULT_RADIUS=50
EXPO_PUBLIC_LEAFLET_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
EXPO_PUBLIC_GEOCODING_API_URL=https://nominatim.openstreetmap.org

# [4] Konfigurasi Biometrik Face Recognition
EXPO_PUBLIC_ENABLE_FACE_RECOGNITION=true
EXPO_PUBLIC_FACE_MATCH_THRESHOLD=0.6
