# ==============================================================================
# HADIRYUK BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Salin file ini menjadi .env lalu sesuaikan nilai variabel dengan server Anda.
# ==============================================================================

# [1] Lingkungan Server & Port
NODE_ENV=production
PORT=3000
TZ=Asia/Jakarta

# [2] Database PostgreSQL (Multi-Tenant)
DATABASE_URL="postgresql://user:password@localhost:5432/absensi?schema=public"

# [3] Keamanan & Token Autentikasi (JWT)
JWT_SECRET="ganti-dengan-secret-acak-yang-sangat-kuat-dan-aman"
JWT_EXPIRES_IN="7d"
SUPER_ADMIN_SETUP_KEY="kunci-rahasia-setup-awal-super-admin"

# [4] Whitelist CORS Domain (Pisahkan dengan koma)
CORS_ALLOWED_ORIGINS="http://localhost:8081,https://app-presensi.domainanda.com,https://api-presensi.domainanda.com"

# [5] Batas Maksimal Upload File / Foto (MB)
UPLOAD_MAX_SIZE_MB=50

# [6] Konfigurasi Biometrik Face Recognition
FACE_MATCH_THRESHOLD=0.6

# [7] Pengaturan Default Kantor & Geofencing
DEFAULT_TENANT_ID=1
DEFAULT_ALLOWED_RADIUS_METERS=50
DEFAULT_OFFICE_LATITUDE=-6.2088
DEFAULT_OFFICE_LONGITUDE=106.8456
